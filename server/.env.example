PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=put_a_long_random_string_here

# Database: MongoDB Atlas free M0 connection string (see README)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/driftscore?retryWrites=true&w=majority

# AI coach: set ONE or more keys. Groq is free and fast: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (free) key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# To use Claude instead: AI_PROVIDER=anthropic and ANTHROPIC_API_KEY=...

# Optional email reminders (Gmail: use an App Password). Leave empty to log reminders in the console.
SMTP_USER=
SMTP_PASS=

# Nudges when the user is not on the site
APP_URL=https://your-app.onrender.com
CRON_SECRET=a_long_random_string
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
